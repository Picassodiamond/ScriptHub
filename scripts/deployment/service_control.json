{
  "name": "Service: Status / Restart",
  "description": "Check, start, stop, restart or reload a systemd service (gunicorn, nginx, celery...) and read its recent log.",
  "category": "Deployment",
  "enabled": true,
  "timeout": 120,
  "allow_concurrent": false,
  "parameters": [
    {"name": "service", "label": "Service name", "type": "text", "required": true, "placeholder": "gunicorn-myapp", "pattern": "[A-Za-z0-9][A-Za-z0-9@._-]*", "help": "As used with systemctl, e.g. nginx or gunicorn-myapp."},
    {"name": "action", "label": "Action", "type": "select", "required": true, "default": "status", "choices": [
      {"value": "status", "label": "Status"},
      {"value": "logs", "label": "Show recent log"},
      {"value": "restart", "label": "Restart"},
      {"value": "reload", "label": "Reload (graceful)"},
      {"value": "start", "label": "Start"},
      {"value": "stop", "label": "Stop"}
    ]},
    {"name": "lines", "label": "Log lines", "type": "number", "default": 50, "min": 1, "max": 5000, "help": "Used by “Show recent log”."}
  ]
}
